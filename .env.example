# Copy to .env and fill in real values. Required for full functionality:
# Pl@ntNet (species ID) and Groq (narrative / action plan). The stack boots
# without them, but those calls will fail at request time.
# When running via docker-compose, DATABASE_URL is overridden automatically.

# --- PostgreSQL ---
POSTGRES_USER=forestry
POSTGRES_PASSWORD=change_me
POSTGRES_DB=forestry
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://forestry:change_me@localhost:5433/forestry

# --- Pl@ntNet ---
PLANTNET_API_KEY=your_plantnet_key

# --- Groq ---
GROQ_API_KEY=your_groq_key
GROQ_MODEL=openai/gpt-oss-120b

# --- Google Earth Engine (optional; mock used when disabled) ---
GEE_ENABLED=false
GEE_SERVICE_ACCOUNT_JSON=

# --- Vision ---
YOLO_WEIGHTS_PATH=weights/trunk-seg.pt
YOLO_ENABLED=true

# --- RAG ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
