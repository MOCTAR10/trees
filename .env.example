# Copy to .env and fill in real values. Required for full functionality:
# Pl@ntNet (species ID) and Groq (narrative / action plan). The stack boots
# without them, but those calls will fail at request time.
# When running via docker-compose, DATABASE_URL is overridden automatically.

# --- PostgreSQL ---
POSTGRES_USER=forestry
POSTGRES_PASSWORD=change_me
POSTGRES_DB=forestry
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://forestry:change_me@localhost:5433/forestry

# --- Pl@ntNet ---
PLANTNET_API_KEY=your_plantnet_key

# --- Groq ---
GROQ_API_KEY=your_groq_key
GROQ_MODEL=openai/gpt-oss-120b

# --- Google Earth Engine (optional; mock used when disabled) ---
# Free for noncommercial use. Register the project, then create a service
# account key and grant it roles/earthengine.viewer +
# roles/serviceusage.serviceUsageConsumer. Point GEE_SERVICE_ACCOUNT_FILE at
# the downloaded key (git-ignored), or paste its contents into _JSON.
GEE_ENABLED=false
GEE_PROJECT=
GEE_SERVICE_ACCOUNT_FILE=
GEE_SERVICE_ACCOUNT_JSON=

# --- Vision ---
YOLO_WEIGHTS_PATH=weights/trunk-seg.pt
YOLO_ENABLED=true

# --- RAG ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Knowledge enrichment (optional; used by tools/enrich_status.py) ---
# IUCN Red List API v4 token: https://api.iucnredlist.org/users/sign_up
IUCN_API_TOKEN=
# CITES / EU / CMS listings need no token: import them from the
# checklist.cites.org CSV exports with `python -m tools.import_listings`.

# --- Gateway security (Track D) ---
# REQUIRE_API_KEY=true hardens the gateway: every /api/* call must send the
# X-API-Key header, otherwise the gateway answers 401. Keep false in local
# dev; set true in production behind TLS. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
REQUIRE_API_KEY=false
API_KEY=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
