# Online presentation (static pages): https://<domaine>/foresterie-app/presentation/ — built from the deck, no API, no key.
location = /foresterie-app/presentation {
    return 301 /foresterie-app/presentation/;
}
# Images are versioned (?v=<build>): cache them for a long time.
location ~ ^/foresterie-app/presentation/((slides|thumbs|assets)/.+)$ {
    alias /var/www/trees/deploy/presentation/site/$1;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000, immutable";
    add_header X-Robots-Tag "noindex";
}
location /foresterie-app/presentation/ {
    alias /var/www/trees/deploy/presentation/site/;
    index index.html;
    try_files $uri $uri/ =404;
    add_header Cache-Control "no-cache";
    add_header X-Robots-Tag "noindex";
}
location /presentation/ {
    return 301 /foresterie-app/presentation/;
}

# Ministry user guide (static pages): https://<domaine>/foresterie-app/guide/ — deploy/guide/site, no API, no key.
location = /foresterie-app/guide {
    return 301 /foresterie-app/guide/;
}
location ~ ^/foresterie-app/guide/((captures|assets)/.+)$ {
    alias /var/www/trees/deploy/guide/site/$1;
    expires 1d;
    add_header Cache-Control "public, max-age=86400";
    add_header X-Robots-Tag "noindex";
}
location /foresterie-app/guide/ {
    alias /var/www/trees/deploy/guide/site/;
    index index.html;
    try_files $uri $uri/ =404;
    add_header Cache-Control "no-cache";
    add_header X-Robots-Tag "noindex";
}
location /guide/ {
    return 301 /foresterie-app/guide/;
}
