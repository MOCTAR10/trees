{
  "expo": {
    "name": "Foresterie",
    "slug": "foresterie-numerique",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E1512",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/leaf_logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0B3D2E"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "La caméra est nécessaire pour photographier l'arbre sous plusieurs angles (vue d'ensemble, écorce, feuilles, fleurs, fruits) et activer la lampe pour des photos nettes.",
        "NSPhotoLibraryUsageDescription": "L'accès à la galerie permet d'importer une photo existante pour compléter une étape de capture (la position GPS reste celle de l'appareil).",
        "NSLocationWhenInUseUsageDescription": "La position GPS est nécessaire pour valider l'espèce dans l'écosystème local et trouver les coopératives à proximité."
      }
    },
    "android": {
      "package": "ga.foresterie.numerique",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/adaptive-icon-background.png"
      }
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-location",
      "expo-sharing",
      "expo-status-bar",
      "expo-font",
      "expo-updates"
    ],
    "extra": {
      "apiUrl": "http://localhost:3000"
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Foresterie Numérique",
      "shortName": "Foresterie"
    },
    "runtimeVersion": "0.1.0",
    "updates": {
      "enabled": true,
      "url": "https://greenleaves.ga/updates/manifest",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    }
  }
}
