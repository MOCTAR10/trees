// Android release APK of the mobile app: expo prebuild + Gradle, signed with the
// production key, published at https://greenleaves.ga/app/foresterie.apk.
// Built only when the native part changes (dependencies, app.json, native modules,
// icons, update certificate) or by hand, and only once the GitHub CI is green.
// JavaScript changes reach phones as over-the-air updates (Jenkinsfile.ota).
// Runs on the Jenkins of the production server (low CPU priority, see deploy/jenkins).
pipeline {
  agent any
  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '15', artifactNumToKeepStr: '5'))
    timeout(time: 120, unit: 'MINUTES')
  }
  environment {
    CI = 'true'
    NODE_OPTIONS = '--max-old-space-size=2048'
    // Memory-bounded build (Jenkins container: 7 GB + swap): 2 parallel tasks, Kotlin
    // compiled in the Gradle process, arm64 only (every phone of the last years).
    GRADLE_OPTS = '-Dorg.gradle.jvmargs=-Xmx2560m -Dorg.gradle.workers.max=2 -Dorg.gradle.daemon=false'
    ORG_GRADLE_PROJECT_reactNativeArchitectures = 'arm64-v8a'
    ORG_GRADLE_PROJECT_kotlin_compiler_execution_strategy = 'in-process'
  }
  stages {
    stage('Changements natifs') {
      when {
        not {
          anyOf {
            changeset 'mobile/package.json'
            changeset 'mobile/package-lock.json'
            changeset 'mobile/app.json'
            changeset 'mobile/modules/**'
            changeset 'mobile/assets/icon.png'
            changeset 'mobile/assets/adaptive-icon-*'
            changeset 'mobile/certs/**'
            changeset 'mobile/Jenkinsfile'
            triggeredBy 'UserIdCause'
            expression { currentBuild.previousSuccessfulBuild == null }
          }
        }
      }
      steps {
        script {
          currentBuild.result = 'NOT_BUILT'
          currentBuild.description = 'Pas de changement natif : mise à jour OTA seulement'
          env.SKIP = 'true'
        }
      }
    }
    stage('CI verte') {
      when { expression { env.SKIP != 'true' } }
      steps {
        script {
          def code = sh(script: "bash deploy/jenkins/wait-ci.sh ${env.GIT_COMMIT} 75", returnStatus: true)
          if (code == 3) {
            currentBuild.result = 'NOT_BUILT'
            currentBuild.description = 'Commit remplacé par un plus récent'
            env.SKIP = 'true'
          } else if (code != 0) {
            error('CI non verte : APK non construit')
          }
        }
      }
    }
    stage('Dépendances') {
      when { expression { env.SKIP != 'true' } }
      steps {
        dir('mobile') {
          sh 'npm ci --no-audit --no-fund'
          sh 'npx tsc --noEmit'
        }
      }
    }
    stage('Projet Android') {
      when { expression { env.SKIP != 'true' } }
      steps {
        dir('mobile') {
          sh 'npx expo prebuild --platform android --clean --no-install'
          sh '''
            sed -i -E "s/versionCode [0-9]+/versionCode ${BUILD_NUMBER}/" android/app/build.gradle
            grep -n "versionCode" android/app/build.gradle
          '''
        }
      }
    }
    stage('APK release') {
      when { expression { env.SKIP != 'true' } }
      steps {
        dir('mobile/android') {
          sh 'nice -n 15 ./gradlew assembleRelease --no-daemon --console=plain'
        }
      }
    }
    stage('Signature et publication') {
      when { expression { env.SKIP != 'true' } }
      steps {
        dir('mobile') {
          sh '''
            set -e
            BT=$(ls -d "$ANDROID_HOME"/build-tools/* | sort -V | tail -1)
            VERSION=$(node -p "require('./app.json').expo.version")
            OUT="foresterie-${VERSION}-${BUILD_NUMBER}.apk"
            "$BT/zipalign" -f -p 4 android/app/build/outputs/apk/release/app-release.apk "$OUT"
            "$BT/apksigner" sign --ks /var/jenkins_secrets/release.keystore \
              --ks-key-alias "$ANDROID_KEY_ALIAS" \
              --ks-pass env:ANDROID_KEYSTORE_PASSWORD --key-pass env:ANDROID_KEYSTORE_PASSWORD "$OUT"
            "$BT/apksigner" verify "$OUT"
            cp "$OUT" /var/www/trees-apk/
            ln -sfn "$OUT" /var/www/trees-apk/foresterie.apk
            ls -1t /var/www/trees-apk/foresterie-*.apk | tail -n +6 | xargs -r rm -f
            echo "Publié : https://greenleaves.ga/app/foresterie.apk ($OUT)"
          '''
          archiveArtifacts artifacts: 'foresterie-*.apk', fingerprint: true
          script { currentBuild.description = "v${BUILD_NUMBER} publiée" }
        }
      }
    }
  }
  post {
    always { cleanWs(deleteDirs: true, notFailBuild: true) }
  }
}
