# Optional, inlined at build/dev time by Expo (SDK 49+). Leave unset to talk to
# an open gateway (local dev). Set to the gateway API key when
# REQUIRE_API_KEY=true (production). Never commit a real key.
EXPO_PUBLIC_API_KEY=

# Base URL of the Node gateway. On a physical device set this to your machine's
# LAN IP (localhost on the phone points at the phone itself). Overrides the
# fallback in app.json (extra.apiUrl).
# EXPO_PUBLIC_API_URL=http://192.168.1.81:3000